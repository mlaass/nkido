+// AVX2 implementation of formant filter
+// Processes 8 samples at a time
+[[gnu::target("avx2")]]
+inline void op_filter_formant_avx2(ExecutionContext& ctx, const Instruction& inst) {
+    // Get buffers
+    float* out_l = ctx.buffers->get(inst.out_buffer);
+    float* out_r = ctx.buffers->get(static_cast<std::uint16_t>(inst.out_buffer + 1));
+    const float* input = ctx.buffers->get(inst.inputs[0]);
+    const bool stereo_in = (inst.flags & InstructionFlag::STEREO_INPUT) != 0;
+    const float* input_r = stereo_in ? ctx.buffers->get(static_cast<std::uint16_t>(inst.inputs[0] + 1)) : nullptr;
+    const float* vowel_a = ctx.buffers->get(inst.inputs[1]);
+    const float* vowel_b = ctx.buffers->get(inst.inputs[2]);
+    const float* morph = ctx.buffers->get(inst.inputs[3]);
+    const float* q_in = ctx.buffers->get(inst.inputs[4]);
+    auto& state = ctx.states->get_or_create<FormantState>(inst.state_id);
+
+    // Handle extended parameters
+    const auto* ext = ctx.states->get_if<ExtendedParams<2>>(ext_params_state_id(inst.state_id));
+    const float* dry_buf = nullptr; float dry_const = 0.0f;
+    const float* wet_buf = nullptr; float wet_const = 1.0f;
+    if (ext) {
+        const auto& d = ext->params[0];
+        if (d.is_constant()) dry_const = d.constant; else dry_buf = ctx.buffers->get(d.buffer_idx);
+        const auto& w = ext->params[1];
+        if (w.is_constant()) wet_const = w.constant; else wet_buf = ctx.buffers->get(w.buffer_idx);
+    }
+
+    // Process in 8-sample blocks
+    for (std::size_t i = 0; i < BLOCK_SIZE; i += 8) {
+        // Load parameters for 8 samples
+        __m256 va = _mm256_load_ps(vowel_a + i);
+        __m256 vb = _mm256_load_ps(vowel_b + i);
+        __m256 m = _mm256_load_ps(morph + i);
+        __m256 q = _mm256_load_ps(q_in + i);
+        
+        // Clamp parameters
+        __m256 zero = _mm256_setzero_ps();
+        __m256 four = _mm256_set1_ps(4.0f);
+        __m256 one = _mm256_set1_ps(1.0f);
+        __m256 twenty = _mm256_set1_ps(20.0f);
+        
+        va = _mm256_max_ps(va, zero);
+        va = _mm256_min_ps(va, four);
+        vb = _mm256_max_ps(vb, zero);
+        vb = _mm256_min_ps(vb, four);
+        m = _mm256_max_ps(m, zero);
+        m = _mm256_min_ps(m, one);
+        q = _mm256_max_ps(q, one);
+        q = _mm256_min_ps(q, twenty);
+        
+        // Get dry/wet coefficients
+        __m256 dry = drywet::coeff_avx2(dry_buf, i, dry_const);
+        __m256 wet = drywet::coeff_avx2(wet_buf, i, wet_const);
+        
+        // Check if formant targets need updating
+        bool update = false;
+        for (int j = 0; j < 8; ++j) {
+            if (vowel_a[i + j] != state.last_vowel_a ||
+                vowel_b[i + j] != state.last_vowel_b ||
+                morph[i + j] != state.last_morph ||
+                q_in[i + j] != state.last_q) {
+                update = true;
+                break;
+            }
+        }
+
+        if (update) {
+            // Update formant targets (scalar fallback for parameter checks)
+            for (std::size_t j = 0; j < 8; ++j) {
+                state.last_vowel_a = vowel_a[i + j];
+                state.last_vowel_b = vowel_b[i + j];
+                state.last_morph = morph[i + j];
+                state.last_q = q_in[i + j];
+            }
+
+            // Interpolate between vowel indices
+            __m256 idx_a = _mm256_floor_ps(va);
+            __m256 idx_b = _mm256_floor_ps(vb);
+            __m256 frac_a = _mm256_sub_ps(va, idx_a);
+            __m256 frac_b = _mm256_sub_ps(vb, idx_b);
+            
+            // Clamp indices to valid range
+            __m256 four_vec = _mm256_set1_ps(4.0f);
+            idx_a = _mm256_min_ps(idx_a, four_vec);
+            idx_b = _mm256_min_ps(idx_b, four_vec);
+            __m256 idx_a2 = _mm256_add_ps(_mm256_floor_ps(_mm256_add_ps(idx_a, one)), _mm256_set1_ps(0.0f));
+            __m256 idx_b2 = _mm256_add_ps(_mm256_floor_ps(_mm256_add_ps(idx_b, one)), _mm256_set1_ps(0.0f));
+            
+            // Get formants for vowel A
+            __m256 f1_a = _mm256_mul_ps(_mm256_sub_ps(_mm256_set1_ps(1.0f), frac_a),
+                                     _mm256_castps128_ps256(VOWEL_TABLE[static_cast<int>(idx_a[0])].f1));
+            __m256 f2_a = _mm256_mul_ps(_mm256_sub_ps(_mm256_set1_ps(1.0f), frac_a),
+                                     _mm256_castps128_ps256(VOWEL_TABLE[static_cast<int>(idx_a[0])].f2));
+            __m256 f3_a = _mm256_mul_ps(_mm256_sub_ps(_mm256_set1_ps(1.0f), frac_a),
+                                     _mm256_castps128_ps256(VOWEL_TABLE[static_cast<int>(idx_a[0])].f3));
+            
+            __m256 g1_a = _mm256_mul_ps(_mm256_sub_ps(_mm256_set1_ps(1.0f), frac_a),
+                                     _mm256_castps128_ps256(VOWEL_TABLE[static_cast<int>(idx_a[0])].g1));
+            __m256 g2_a = _mm256_mul_ps(_mm256_sub_ps(_mm256_set1_ps(1.0f), frac_a),
+                                     _mm256_castps128_ps256(VOWEL_TABLE[static_cast<int>(idx_a[0])].g2));
+            __m256 g3_a = _mm256_mul_ps(_mm256_sub_ps(_mm256_set1_ps(1.0f), frac_a),
+                                     _mm256_castps128_ps256(VOWEL_TABLE[static_cast<int>(idx_a[0])].g3));
+            
+            // Get formants for vowel B
+            __m256 f1_b = _mm256_mul_ps(_mm256_sub_ps(_mm256_set1_ps(1.0f), frac_b),
+                                     _mm256_castps128_ps256(VOWEL_TABLE[static_cast<int>(idx_b[0])].f1));
+            __m256 f2_b = _mm256_mul_ps(_mm256_sub_ps(_mm256_set1_ps(1.0f), frac_b),
+                                     _mm256_castps128_ps256(VOWEL_TABLE[static_cast<int>(idx_b[0])].f2));
+            __m256 f3_b = _mm256_mul_ps(_mm256_sub_ps(_mm256_set1_ps(1.0f), frac_b),
+                                     _mm256_castps128_ps256(VOWEL_TABLE[static_cast<int>(idx_b[0])].f3));
+            
+            __m256 g1_b = _mm256_mul_ps(_mm256_sub_ps(_mm256_set1_ps(1.0f), frac_b),
+                                     _mm256_castps128_ps256(VOWEL_TABLE[static_cast<int>(idx_b[0])].g1));
+            __m256 g2_b = _mm256_mul_ps(_mm256_sub_ps(_mm256_set1_ps(1.0f), frac_b),
+                                     _mm256_castps128_ps256(VOWEL_TABLE[static_cast<int>(idx_b[0])].g2));
+            __m256 g3_b = _mm256_mul_ps(_mm256_sub_ps(_mm256_set1_ps(1.0f), frac_b),
+                                     _mm256_castps128_ps256(VOWEL_TABLE[static_cast<int>(idx_b[0])].g3));
+            
+            // Morph between A and B
+            state.f1 = _mm256_add_ps(_mm256_mul_ps(_mm256_sub_ps(_mm256_set1_ps(1.0f), m), f1_a),
+                                   _mm256_mul_ps(m, f1_b));
+            state.f2 = _mm256_add_ps(_mm256_mul_ps(_mm256_sub_ps(_mm256_set1_ps(1.0f), m), f2_a),
+                                   _mm256_mul_ps(m, f2_b));
+            state.f3 = _mm256_add_ps(_mm256_mul_ps(_mm256_sub_ps(_mm256_set1_ps(1.0f), m), f3_a),
+                                   _mm256_mul_ps(m, f3_b));
+            
+            state.g1 = _mm256_add_ps(_mm256_mul_ps(_mm256_sub_ps(_mm256_set1_ps(1.0f), m), g1_a),
+                                   _mm256_mul_ps(m, g1_b));
+            state.g2 = _mm256_add_ps(_mm256_mul_ps(_mm256_sub_ps(_mm256_set1_ps(1.0f), m), g2_a),
+                                   _mm256_mul_ps(m, g2_b));
+            state.g3 = _mm256_add_ps(_mm256_mul_ps(_mm256_sub_ps(_mm256_set1_ps(1.0f), m), g3_a),
+                                   _mm256_mul_ps(m, g3_b));
+        }
+
+        // Prewarp coefficients
+        __m256 sample_rate = _mm256_set1_ps(ctx.sample_rate);
+        __m256 pi = _mm256_set1_ps(PI);
+        
+        __m256 f1_coef = _mm256_mul_ps(_mm256_set1_ps(2.0f),
+                                      _mm256_tan_ps(_mm256_mul_ps(_mm256_div_ps(_mm256_mul_ps(pi, state.f1), sample_rate),
+                                                              _mm256_set1_ps(0.48f))));
+        
+        __m256 f2_coef = _mm256_mul_ps(_mm256_set1_ps(2.0f),
+                                      _mm256_tan_ps(_mm256_mul_ps(_mm256_div_ps(_mm256_mul_ps(pi, state.f2), sample_rate),
+                                                              _mm256_set1_ps(0.48f))));
+        
+        __m256 f3_coef = _mm256_mul_ps(_mm256_set1_ps(2.0f),
+                                      _mm256_tan_ps(_mm256_mul_ps(_mm256_div_ps(_mm256_mul_ps(pi, state.f3), sample_rate),
+                                                              _mm256_set1_ps(0.48f))));
+        
+        __m256 q_coef = _mm256_div_ps(_mm256_set1_ps(1.0f), q);
+        
+        // Process each channel
+        for (std::size_t ch = 0; ch < 2; ++ch) {
+            __m256 x = (ch == 0) ? _mm256_load_ps(input + i) :
+                       (stereo_in ? _mm256_load_ps(input_r + i) : _mm256_load_ps(input + i));
+
+            // Bandpass 1 (F1 - first formant)
+            __m256 hp1 = _mm256_sub_ps(x, _mm256_mul_ps(state.bp1_z1[ch], q_coef));
+            hp1 = _mm256_sub_ps(hp1, state.bp1_z2[ch]);
+            __m256 bp1 = _mm256_add_ps(state.bp1_z1[ch], _mm256_mul_ps(f1_coef, hp1));
+            __m256 lp1 = _mm256_add_ps(state.bp1_z2[ch], _mm256_mul_ps(f1_coef, state.bp1_z1[ch]));
+            
+            state.bp1_z1[ch] = _mm256_store_ps(&state.bp1_z1[ch][0], _mm256_min_ps(_mm256_max_ps(bp1, _mm256_set1_ps(-10.0f)), _mm256_set1_ps(10.0f)));
+            state.bp1_z2[ch] = _mm256_store_ps(&state.bp1_z2[ch][0], _mm256_min_ps(_mm256_max_ps(lp1, _mm256_set1_ps(-10.0f)), _mm256_set1_ps(10.0f)));
+
+            // Bandpass 2 (F2 - second formant)
+            __m256 hp2 = _mm256_sub_ps(x, _mm256_mul_ps(state.bp2_z1[ch], q_coef));
+            hp2 = _mm256_sub_ps(hp2, state.bp2_z2[ch]);
+            __m256 bp2 = _mm256_add_ps(state.bp2_z1[ch], _mm256_mul_ps(f2_coef, hp2));
+            __m256 lp2 = _mm256_add_ps(state.bp2_z2[ch], _mm256_mul_ps(f2_coef, state.bp2_z1[ch]));
+            
+            state.bp2_z1[ch] = _mm256_store_ps(&state.bp2_z1[ch][0], _mm256_min_ps(_mm256_max_ps(bp2, _mm256_set1_ps(-10.0f)), _mm256_set1_ps(10.0f)));
+            state.bp2_z2[ch] = _mm256_store_ps(&state.bp2_z2[ch][0], _mm256_min_ps(_mm256_max_ps(lp2, _mm256_set1_ps(-10.0f)), _mm256_set1_ps(10.0f)));
+
+            // Bandpass 3 (F3 - third formant)
+            __m256 hp3 = _mm256_sub_ps(x, _mm256_mul_ps(state.bp3_z1[ch], q_coef));
+            hp3 = _mm256_sub_ps(hp3, state.bp3_z2[ch]);
+            __m256 bp3 = _mm256_add_ps(state.bp3_z1[ch], _mm256_mul_ps(f3_coef, hp3));
+            __m256 lp3 = _mm256_add_ps(state.bp3_z2[ch], _mm256_mul_ps(f3_coef, state.bp3_z1[ch]));
+            
+            state.bp3_z1[ch] = _mm256_store_ps(&state.bp3_z1[ch][0], _mm256_min_ps(_mm256_max_ps(bp3, _mm256_set1_ps(-10.0f)), _mm256_set1_ps(10.0f)));
+            state.bp3_z2[ch] = _mm256_store_ps(&state.bp3_z2[ch][0], _mm256_min_ps(_mm256_max_ps(lp3, _mm256_set1_ps(-10.0f)), _mm256_set1_ps(10.0f)));
 
