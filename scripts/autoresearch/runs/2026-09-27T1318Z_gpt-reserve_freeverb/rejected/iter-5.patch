@@ -35,6 +35,9 @@ constexpr float FREEVERB_ROOM_OFFSET_DEFAULT = 0.7f;
 
 [[gnu::always_inline]]
 inline void op_reverb_freeverb(ExecutionContext& ctx, const Instruction& inst) {
