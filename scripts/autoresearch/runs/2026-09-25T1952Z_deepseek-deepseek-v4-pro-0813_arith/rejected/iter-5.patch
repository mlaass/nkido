+#define CEDAR_ARITH_DEFINE_AVX2(kernel, expr)                                                       \
+    CEDAR_TARGET_AVX2 inline void kernel(const float* __restrict a, const float* __restrict b,    \
+                                         float* __restrict out) noexcept {                         \
+        CEDAR_SIMD_ASSERT_ALIGNED(a, 32);                                                          \
+        CEDAR_SIMD_ASSERT_ALIGNED(b, 32);                                                          \
+        CEDAR_SIMD_ASSERT_ALIGNED(out, 32);                                                        \
+        a = static_cast<const float*>(__builtin_assume_aligned(a, 32));                           \
+        b = static_cast<const float*>(__builtin_assume_aligned(b, 32));                           \
+        out = static_cast<float*>(__builtin_assume_aligned(out, 32));                             \
+        _Pragma("GCC ivdep")                                                                       \
+        for (std::size_t i = 0; i < BLOCK_SIZE; ++i) {                                             \
+            out[i] = expr;                                                                         \
+        }                                                                                          \
     }
-}
 
