+#if CEDAR_SIMD_X86
+// The generated bytecode only references armable pool slots, so the AVX2 path
+// can resolve a buffer without the defensive bounds/null checks in
+// BufferPool::get. The scalar fallback below keeps the original checked path.
+[[gnu::always_inline]]
+inline float* arith_buffer(const BufferPool& pool, std::uint16_t index) noexcept {
+    return pool.slabs_[index / SLAB_BUFFERS].get()->data[index % SLAB_BUFFERS].data();
+}
+#endif
