+// 128 samples = 16 AVX2 vectors; the load/compute/store for each vector is kept
+// together in scalar order (safe for out == a/out == b accumulator patterns).
+// Add/sub/mul are IEEE bit-identical in AVX2 and SSE/scalar for every float
+// class, including NaN, zero, and denormal operands.
+#define CEDAR_DEFINE_ARITH_AVX2(name, op)                                                       \
+    [[gnu::target("avx2")]] inline void name(const float* a, const float* b, float* out) noexcept { \
+        CEDAR_SIMD_ASSERT_ALIGNED(a, 32);                                                      \
+        CEDAR_SIMD_ASSERT_ALIGNED(b, 32);                                                      \
+        CEDAR_SIMD_ASSERT_ALIGNED(out, 32);                                                    \
+        for (std::size_t i = 0; i < BLOCK_SIZE; i += 8) {                                      \
+            const __m256 va = _mm256_load_ps(a + i);                                            \
+            const __m256 vb = _mm256_load_ps(b + i);                                            \
+            const __m256 vr = _mm256_##op##_ps(va, vb);                                         \
+            _mm256_store_ps(out + i, vr);                                                       \
+        }                                                                                       \
     }
-}
 
