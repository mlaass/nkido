+// simd: approx division inside std::tanh's approximation. All denominators
+// below are positive normal floats; one Newton step squares the reciprocal
+// estimate's relative error, reducing it to roughly float precision.
+CEDAR_TARGET_AVX2 inline __m256 distort_tanh_div_avx2(__m256 numerator, __m256 denominator) noexcept {
+    const __m256 reciprocal = _mm256_rcp_ps(denominator);
+    const __m256 refined = _mm256_mul_ps(reciprocal,
+        _mm256_sub_ps(_mm256_set1_ps(2.0f), _mm256_mul_ps(denominator, reciprocal)));
+    return _mm256_mul_ps(numerator, refined);
+}
