-    CEDAR_SIMD_ASSERT_ALIGNED(b, 32);
-    CEDAR_SIMD_ASSERT_ALIGNED(out, 32);
+CEDAR_TARGET_AVX2 inline void mul_avx2(const float* __attribute__((assume_aligned(32))) a,
+                                         const float* __attribute__((assume_aligned(32))) b,
+                                         float* __attribute__((assume_aligned(32))) out) noexcept {
+    #pragma GCC ivdep
     for (std::size_t i = 0; i < cedar::BLOCK_SIZE; i += 8) {
         _mm256_store_ps(out + i, _mm256_mul_ps(_mm256_load_ps(a + i), _mm256_load_ps(b + i)));
     }
