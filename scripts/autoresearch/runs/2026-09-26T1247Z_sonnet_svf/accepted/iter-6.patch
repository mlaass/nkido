+            const __m128 s2 = _mm_fmadd_ps(D2p, sw, _mm_fmadd_ps(D1p, s, cp));
+            const __m128 va = _mm_add_ps(s1, s);
+            const __m128 vb = _mm_add_ps(s2, s1);
+            if constexpr (Mode != SvfLP) {
