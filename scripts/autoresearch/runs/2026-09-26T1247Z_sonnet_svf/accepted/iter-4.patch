+    const __m256 a = _mm256_load_ps(p);
+    const __m256 b = _mm256_load_ps(p + 8);
+    l = _mm256_shuffle_ps(a, b, 0x88);
+    r = _mm256_shuffle_ps(a, b, 0xDD);
