 // Classic warm saturation using hyperbolic tangent.
 // Higher drive values push the signal into saturation more aggressively.
 
+namespace distortion_kernels {
+#if CEDAR_SIMD_X86
+CEDAR_TARGET_AVX2 inline __m256 tanh_avx2(__m256 x) noexcept {
+    const __m256 sign = _mm256_and_ps(x, _mm256_set1_ps(-0.0f));
+    const __m256 ax = _mm256_andnot_ps(_mm256_set1_ps(-0.0f), x);
+    const __m256 one = _mm256_set1_ps(1.0f);
+    const __m256 max_x = _mm256_set1_ps(9.0f);
+    const __m256 z = _mm256_min_ps(ax, max_x);
+    const __m256 z2 = _mm256_mul_ps(z, z);
+    const __m256 p = _mm256_add_ps(_mm256_set1_ps(378.0f), z2);
+    const __m256 p2 = _mm256_add_ps(_mm256_set1_ps(17325.0f), _mm256_mul_ps(z2, p));
+    const __m256 p3 = _mm256_add_ps(_mm256_set1_ps(135135.0f), _mm256_mul_ps(z2, p2));
+    const __m256 q = _mm256_add_ps(_mm256_set1_ps(3150.0f), _mm256_mul_ps(_mm256_set1_ps(28.0f), z2));
+    const __m256 q2 = _mm256_add_ps(_mm256_set1_ps(62370.0f), _mm256_mul_ps(z2, q));
+    const __m256 q3 = _mm256_add_ps(_mm256_set1_ps(135135.0f), _mm256_mul_ps(z2, q2));
+    const __m256 r = _mm256_mul_ps(z, _mm256_mul_ps(p3, _mm256_rcp_ps(q3)));
+    const __m256 sat = _mm256_blendv_ps(r, one, _mm256_cmp_ps(ax, max_x, _CMP_GT_OQ));
+    return _mm256_or_ps(sat, sign);
+}
+
+CEDAR_TARGET_AVX2 inline void distort_tanh_avx2(const float* input, const float* input_r,
+    const float* drive, const float* dry_level, const float* wet_level,
+    float* out_l, float* out_r, bool stereo) noexcept {
+    const __m256 min_drive = _mm256_set1_ps(0.1f);
+    const __m256 zero = _mm256_setzero_ps();
+    const __m256 one = _mm256_set1_ps(1.0f);
+    for (std::size_t i = 0; i < BLOCK_SIZE; i += 8) {
+        const __m256 d = _mm256_max_ps(_mm256_load_ps(drive + i), min_drive);
+        const __m256 dry = dry_level ? _mm256_load_ps(dry_level + i) : zero;
+        const __m256 wet = wet_level ? _mm256_load_ps(wet_level + i) : one;
+        const __m256 l = _mm256_load_ps(input + i);
+        const __m256 r = stereo ? _mm256_load_ps(input_r + i) : l;
+        const __m256 yl = _mm256_mul_ps(tanh_avx2(_mm256_mul_ps(l, d)), one);
+        const __m256 yr = _mm256_mul_ps(tanh_avx2(_mm256_mul_ps(r, d)), one);
+        _mm256_store_ps(out_l + i, _mm256_add_ps(_mm256_mul_ps(l, dry), _mm256_mul_ps(yl, wet)));
+        _mm256_store_ps(out_r + i, _mm256_add_ps(_mm256_mul_ps(r, dry), _mm256_mul_ps(yr, wet)));
+    }
+}
+
+CEDAR_TARGET_AVX2 inline __m256 soft_avx2(__m256 x) noexcept {
+    const __m256 ax = _mm256_andnot_ps(_mm256_set1_ps(-0.0f), x);
+    const __m256 x2 = _mm256_mul_ps(x, x);
+    const __m256 y = _mm256_mul_ps(x, _mm256_div_ps(
+        _mm256_add_ps(_mm256_set1_ps(27.0f), x2),
+        _mm256_add_ps(_mm256_set1_ps(27.0f), _mm256_mul_ps(_mm256_set1_ps(9.0f), x2))));
+    const __m256 limit = _mm256_set1_ps(3.0f);
+    return _mm256_blendv_ps(y, _mm256_or_ps(_mm256_and_ps(x, _mm256_set1_ps(-0.0f)), _mm256_set1_ps(1.0f)),
+        _mm256_cmp_ps(ax, limit, _CMP_GT_OQ));
+}
+
+CEDAR_TARGET_AVX2 inline void distort_soft_avx2(const float* input, const float* input_r,
+    const float* threshold, const float* dry_level, const float* wet_level,
+    float* out_l, float* out_r, bool stereo) noexcept {
+    const __m256 lo = _mm256_set1_ps(0.1f), hi = _mm256_set1_ps(2.0f);
+    const __m256 zero = _mm256_setzero_ps(), one = _mm256_set1_ps(1.0f);
+    for (std::size_t i = 0; i < BLOCK_SIZE; i += 8) {
+        const __m256 t = _mm256_min_ps(_mm256_max_ps(_mm256_load_ps(threshold + i), lo), hi);
+        const __m256 dry = dry_level ? _mm256_load_ps(dry_level + i) : zero;
+        const __m256 wet = wet_level ? _mm256_load_ps(wet_level + i) : one;
+        const __m256 l = _mm256_load_ps(input + i);
+        const __m256 r = stereo ? _mm256_load_ps(input_r + i) : l;
+        const __m256 yl = _mm256_mul_ps(soft_avx2(_mm256_div_ps(l, t)), t);
+        const __m256 yr = _mm256_mul_ps(soft_avx2(_mm256_div_ps(r, t)), t);
+        _mm256_store_ps(out_l + i, _mm256_add_ps(_mm256_mul_ps(l, dry), _mm256_mul_ps(yl, wet)));
+        _mm256_store_ps(out_r + i, _mm256_add_ps(_mm256_mul_ps(r, dry), _mm256_mul_ps(yr, wet)));
+    }
+}
+#endif
+}
