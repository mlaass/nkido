+// Block arithmetic: elementwise op over BLOCK_SIZE floats, 8 lanes per
+// vector. The loop is unrolled x2 and pipelined — all four loads of a pair
+// issue before either store retires — so the per-copy cost is load-issue
+// bound (2 x 32B loads/cycle) with no per-chunk loop control competing for
+// the front end. Chunks are disjoint 32-byte blocks, so no load depends on
+// a store of the same kernel; `out` may alias `a`/`b` (in-place ops are
+// legal) and each element is still read before it is written, exactly like
+// the scalar oracle. Same instructions per element as the 1x loop, so the
+// output is bit-identical (no FMA, no FTZ, MXCSR untouched).
 CEDAR_TARGET_AVX2 inline void add_avx2(const float* a, const float* b, float* out) noexcept {
-    for (std::size_t i = 0; i < BLOCK_SIZE; i += 8)
-        _mm256_store_ps(out + i, _mm256_add_ps(_mm256_load_ps(a + i), _mm256_load_ps(b + i)));
+    CEDAR_SIMD_ASSERT_ALIGNED(a, 32);
+    CEDAR_SIMD_ASSERT_ALIGNED(b, 32);
+    CEDAR_SIMD_ASSERT_ALIGNED(out, 32);
+    std::size_t i = 0;
+#pragma GCC unroll 8
+    for (; i + 16 <= BLOCK_SIZE; i += 16) {
+        const __m256 x0 = _mm256_load_ps(a + i);
+        const __m256 y0 = _mm256_load_ps(b + i);
+        const __m256 x1 = _mm256_load_ps(a + i + 8);
+        const __m256 y1 = _mm256_load_ps(b + i + 8);
+        _mm256_store_ps(out + i, _mm256_add_ps(x0, y0));
+        _mm256_store_ps(out + i + 8, _mm256_add_ps(x1, y1));
+    }
+    if (i < BLOCK_SIZE) {  // tail: compile-time dead for BLOCK_SIZE % 16 == 0
+        const __m256 x = _mm256_load_ps(a + i);
+        const __m256 y = _mm256_load_ps(b + i);
+        _mm256_store_ps(out + i, _mm256_add_ps(x, y));
+    }
 }
