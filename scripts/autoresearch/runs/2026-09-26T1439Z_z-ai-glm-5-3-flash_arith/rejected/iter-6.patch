+namespace {
+// Fast-path buffer address for indices that live in slab 0 (< SLAB_BUFFERS):
+// all three slabs_ arrays alias the same std::unique_ptr<Slab>, so one
+// aligned 16-byte load of the triplet gives the slab-0 base (checked == the
+// non-null scalar `get()` result) and buffer k sits at base + k*BLOCK_SIZE.
+// Anything else — out-of-range 0xFFFF, later slabs — goes through the exact
+// get() path, so pointer results are identical in every case.
+inline float* fast0(const BufferPool& pool, std::uint16_t idx, const float* get0) noexcept {
+    return const_cast<float*>(get0) + static_cast<std::size_t>(idx) * BLOCK_SIZE;
+}
