+#if CEDAR_SIMD_X86
+CEDAR_TARGET_AVX2 inline void distort_tanh_avx2(const float* input, const float* input_r,
+                                                 const float* drive, const float* dry_level,
+                                                 const float* wet_level,
+                                                 float* out_l, float* out_r,
+                                                 bool stereo_in) noexcept {
+    constexpr std::size_t BLOCK_SIZE = 128;
+    constexpr float MIN_DRIVE = 0.1f;
+    constexpr float DRY_DEFAULT = 0.0f;
+    constexpr float WET_DEFAULT = 1.0f;
+
+    // AVX2 constants
+    const __m256 v_min_drive = _mm256_set1_ps(MIN_DRIVE);
+    const __m256 v_dry_default = _mm256_set1_ps(DRY_DEFAULT);
+    const __m256 v_wet_default = _mm256_set1_ps(WET_DEFAULT);
+
+    // tanh approximation coefficients (minimax polynomial, error < 1e-5)
+    // tanh(x) ≈ x * (1 - x^2 * (a - b * x^2)) for |x| < 1
+    // For larger |x|, tanh saturates to ±1
+    // Using: tanh(x) = sign(x) * (1 - 2/(exp(2|x|)+1))
+    // Fast approximation: x * (1 + c1*x^2 + c2*x^4) / (1 + c3*x^2 + c4*x^4)
+    // From "Fast Computation of tanh(x)" - max abs error ~2.5e-6
+    const __m256 c1 = _mm256_set1_ps(0.153854f);   // 2/13
+    const __m256 c2 = _mm256_set1_ps(0.003275f);   // 2/611
+    const __m256 c3 = _mm256_set1_ps(0.006550f);   // 2/305
+    const __m256 c4 = _mm256_set1_ps(0.000000f);
+
+    // Better: minimax polynomial for tanh on [-4, 4], then clamp
+    // tanh(x) ≈ x - x^3/3 + 2x^5/15 - 17x^7/315 ... but we want rational
+    // Using rational approximation: tanh(x) ≈ x * (27 + x^2) / (27 + 9*x^2) for soft clip,
+    // but that's different. For tanh, use:
+    // tanh(x) = x * (1 - x^2 * (1/3 - x^2 * (2/15 - x^2 * (17/315))))
+    // Better: Padé approximant tanh(x) ≈ x * (1 + 0.153854*x^2) / (1 + 0.00655*x^2 + 0.000000*x^4) ? No
+
+    // From Abramowitz & Stegun / various sources:
+    // tanh(x) for |x| <= 2: x * (a0 + a1*x^2 + a2*x^4) / (b0 + b1*x^2 + b2*x^4)
+    // Coefficients for minimax on [-2,2]:
+    // a0 = 1.0, a1 = 0.153854, a2 = 0.003275
+    // b0 = 1.0, b1 = 0.006550, b2 = 0.0
+    // Max error ~ 4.5e-6
+
+    const __m256 a0 = _mm256_set1_ps(1.0f);
+    const __m256 a1 = _mm256_set1_ps(0.153854f);
+    const __m256 a2 = _mm256_set1_ps(0.003275f);
+    const __m256 b0 = _mm256_set1_ps(1.0f);
+    const __m256 b1 = _mm256_set1_ps(0.006550f);
+    const __m256 b2 = _mm256_set1_ps(0.0f);
+
+    const __m256 v_thresh = _mm256_set1_ps(2.0f);  // switch to ±1 for |x| > 2
+    const __m256 v_one = _mm256_set1_ps(1.0f);
+
+    for (std::size_t i = 0; i < BLOCK_SIZE; i += 8) {
+        // Load drive (8 floats)
+        __m256 v_drive = _mm256_load_ps(drive + i);
+        v_drive = _mm256_max_ps(v_drive, v_min_drive);
+
+        // Load dry/wet
+        __m256 v_dry = dry_level ? _mm256_load_ps(dry_level + i) : v_dry_default;
+        __m256 v_wet = wet_level ? _mm256_load_ps(wet_level + i) : v_wet_default;
+
+        // Load left input
+        __m256 v_x_l = _mm256_load_ps(input + i);
+
+        // Load right input
+        __m256 v_x_r = stereo_in ? _mm256_load_ps(input_r + i) : v_x_l;
+
+        // Process left channel
+        __m256 v_x_drive_l = _mm256_mul_ps(v_x_l, v_drive);
+
+        // tanh approximation: x * (a0 + a1*x^2 + a2*x^4) / (b0 + b1*x^2 + b2*x^4)
+        __m256 v_x2_l = _mm256_mul_ps(v_x_drive_l, v_x_drive_l);
+        __m256 v_x4_l = _mm256_mul_ps(v_x2_l, v_x2_l);
+
+        __m256 v_num_l = _mm256_add_ps(a0,
+            _mm256_add_ps(_mm256_mul_ps(a1, v_x2_l), _mm256_mul_ps(a2, v_x4_l)));
+        __m256 v_den_l = _mm256_add_ps(b0,
+            _mm256_add_ps(_mm256_mul_ps(b1, v_x2_l), _mm256_mul_ps(b2, v_x4_l)));
+
+        __m256 v_tanh_l = _mm256_div_ps(v_num_l, v_den_l);
+        v_tanh_l = _mm256_mul_ps(v_x_drive_l, v_tanh_l);
+
+        // Clamp for large |x|
+        __m256 v_abs_l = _mm256_and_ps(v_x_drive_l, _mm256_set1_ps(0x7FFFFFFF));
+        __m256 v_mask_l = _mm256_cmp_ps(v_abs_l, v_thresh, _CMP_GT_OQ);
+        v_tanh_l = _mm256_blendv_ps(v_tanh_l, _mm256_and_ps(v_x_drive_l, _mm256_set1_ps(0x80000000)), v_mask_l);
+        // Actually for |x| > 2, tanh ≈ ±1, so:
+        v_tanh_l = _mm256_blendv_ps(v_tanh_l,
+            _mm256_xor_ps(v_x_drive_l, _mm256_and_ps(v_x_drive_l, _mm256_set1_ps(0x80000000))), v_mask_l);
+        // Simpler: sign(x) * 1.0
+        __m256 v_sign_l = _mm256_and_ps(v_x_drive_l, _mm256_set1_ps(-0.0f)); // sign bit
+        __m256 v_sat_l = _mm256_or_ps(v_sign_l, v_one);
+        v_tanh_l = _mm256_blendv_ps(v_tanh_l, v_sat_l, v_mask_l);
+
+        // drywet mix: out = x * dry + processed * wet
+        __m256 v_out_l = _mm256_add_ps(_mm256_mul_ps(v_x_l, v_dry), _mm256_mul_ps(v_tanh_l, v_wet));
+        _mm256_store_ps(out_l + i, v_out_l);
+
+        // Process right channel
+        __m256 v_x_drive_r = _mm256_mul_ps(v_x_r, v_drive);
+
+        __m256 v_x2_r = _mm256_mul_ps(v_x_drive_r, v_x_drive_r);
+        __m256 v_x4_r = _mm256_mul_ps(v_x2_r, v_x2_r);
+
+        __m256 v_num_r = _mm256_add_ps(a0,
+            _mm256_add_ps(_mm256_mul_ps(a1, v_x2_r), _mm256_mul_ps(a2, v_x4_r)));
+        __m256 v_den_r = _mm256_add_ps(b0,
+            _mm256_add_ps(_mm256_mul_ps(b1, v_x2_r), _mm256_mul_ps(b2, v_x4_r)));
+
+        __m256 v_tanh_r = _mm256_div_ps(v_num_r, v_den_r);
+        v_tanh_r = _mm256_mul_ps(v_x_drive_r, v_tanh_r);
+
+        __m256 v_abs_r = _mm256_and_ps(v_x_drive_r, _mm256_set1_ps(0x7FFFFFFF));
+        __m256 v_mask_r = _mm256_cmp_ps(v_abs_r, v_thresh, _CMP_GT_OQ);
+        __m256 v_sign_r = _mm256_and_ps(v_x_drive_r, _mm256_set1_ps(-0.0f));
+        __m256 v_sat_r = _mm256_or_ps(v_sign_r, v_one);
+        v_tanh_r = _mm256_blendv_ps(v_tanh_r, v_sat_r, v_mask_r);
+
+        __m256 v_out_r = _mm256_add_ps(_mm256_mul_ps(v_x_r, v_dry), _mm256_mul_ps(v_tanh_r, v_wet));
+        _mm256_store_ps(out_r + i, v_out_r);
+    }
+}
