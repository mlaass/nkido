+CEDAR_TARGET_AVX2 inline void distort_soft_avx2(const float* input, const float* input_r,
+                                                 const float* threshold, const float* dry_level,
+                                                 const float* wet_level,
+                                                 float* out_l, float* out_r,
+                                                 bool stereo_in) noexcept {
+    constexpr std::size_t BLOCK_SIZE = 128;
+    constexpr float MIN_THRESH = 0.1f;
+    constexpr float MAX_THRESH = 2.0f;
+    constexpr float DRY_DEFAULT = 0.0f;
+    constexpr float WET_DEFAULT = 1.0f;
+    constexpr float SOFT_LIMIT = 3.0f;
+
+    const __m256 v_min_thresh = _mm256_set1_ps(MIN_THRESH);
+    const __m256 v_max_thresh = _mm256_set1_ps(MAX_THRESH);
+    const __m256 v_dry_default = _mm256_set1_ps(DRY_DEFAULT);
+    const __m256 v_wet_default = _mm256_set1_ps(WET_DEFAULT);
+    const __m256 v_soft_limit = _mm256_set1_ps(SOFT_LIMIT);
+    const __m256 v_neg_soft_limit = _mm256_set1_ps(-SOFT_LIMIT);
+    const __m256 v_one = _mm256_set1_ps(1.0f);
+    const __m256 v_neg_one = _mm256_set1_ps(-1.0f);
+
+    // soft(x) = x * (27 + x^2) / (27 + 9*x^2) for |x| <= 3
+    // = ±1 for |x| > 3
+    const __m256 c_27 = _mm256_set1_ps(27.0f);
+    const __m256 c_9 = _mm256_set1_ps(9.0f);
+
+    for (std::size_t i = 0; i < BLOCK_SIZE; i += 8) {
+        // Load and clamp threshold
+        __m256 v_thresh = _mm256_load_ps(threshold + i);
+        v_thresh = _mm256_max_ps(_mm256_min_ps(v_thresh, v_max_thresh), v_min_thresh);
+
+        // Load dry/wet
+        __m256 v_dry = dry_level ? _mm256_load_ps(dry_level + i) : v_dry_default;
+        __m256 v_wet = wet_level ? _mm256_load_ps(wet_level + i) : v_wet_default;
+
+        // Load left input
+        __m256 v_x_l = _mm256_load_ps(input + i);
+
+        // Load right input
+        __m256 v_x_r = stereo_in ? _mm256_load_ps(input_r + i) : v_x_l;
+
+        // Process left: soft(x_l / t) * t
+        __m256 v_x_div_t_l = _mm256_div_ps(v_x_l, v_thresh);
+
+        // Clamp to [-3, 3]
+        __m256 v_x_clamped_l = _mm256_max_ps(_mm256_min_ps(v_x_div_t_l, v_soft_limit), v_neg_soft_limit);
+
+        // soft(x) = x * (27 + x^2) / (27 + 9*x^2)
+        __m256 v_x2_l = _mm256_mul_ps(v_x_clamped_l, v_x_clamped_l);
+        __m256 v_num_l = _mm256_mul_ps(v_x_clamped_l, _mm256_add_ps(c_27, v_x2_l));
+        __m256 v_den_l = _mm256_add_ps(c_27, _mm256_mul_ps(c_9, v_x2_l));
+        __m256 v_soft_l = _mm256_div_ps(v_num_l, v_den_l);
+
+        // For |x| > 3, result is ±1
+        __m256 v_mask_pos_l = _mm256_cmp_ps(v_x_div_t_l, v_soft_limit, _CMP_GT_OQ);
+        __m256 v_mask_neg_l = _mm256_cmp_ps(v_x_div_t_l, v_neg_soft_limit, _CMP_LT_OQ);
+        v_soft_l = _mm256_blendv_ps(v_soft_l, v_one, v_mask_pos_l);
+        v_soft_l = _mm256_blendv_ps(v_soft_l, v_neg_one, v_mask_neg_l);
+
+        // Multiply by threshold
+        v_soft_l = _mm256_mul_ps(v_soft_l, v_thresh);
+
+        // drywet mix
+        __m256 v_out_l = _mm256_add_ps(_mm256_mul_ps(v_x_l, v_dry), _mm256_mul_ps(v_soft_l, v_wet));
+        _mm256_store_ps(out_l + i, v_out_l);
+
+        // Process right
+        __m256 v_x_div_t_r = _mm256_div_ps(v_x_r, v_thresh);
+        __m256 v_x_clamped_r = _mm256_max_ps(_mm256_min_ps(v_x_div_t_r, v_soft_limit), v_neg_soft_limit);
+
+        __m256 v_x2_r = _mm256_mul_ps(v_x_clamped_r, v_x_clamped_r);
+        __m256 v_num_r = _mm256_mul_ps(v_x_clamped_r, _mm256_add_ps(c_27, v_x2_r));
+        __m256 v_den_r = _mm256_add_ps(c_27, _mm256_mul_ps(c_9, v_x2_r));
+        __m256 v_soft_r = _mm256_div_ps(v_num_r, v_den_r);
+
+        __m256 v_mask_pos_r = _mm256_cmp_ps(v_x_div_t_r, v_soft_limit, _CMP_GT_OQ);
+        __m256 v_mask_neg_r = _mm256_cmp_ps(v_x_div_t_r, v_neg_soft_limit, _CMP_LT_OQ);
+        v_soft_r = _mm256_blendv_ps(v_soft_r, v_one, v_mask_pos_r);
+        v_soft_r = _mm256_blendv_ps(v_soft_r, v_neg_one, v_mask_neg_r);
+
+        v_soft_r = _mm256_mul_ps(v_soft_r, v_thresh);
+
+        __m256 v_out_r = _mm256_add_ps(_mm256_mul_ps(v_x_r, v_dry), _mm256_mul_ps(v_soft_r, v_wet));
+        _mm256_store_ps(out_r + i, v_out_r);
+    }
+}
+#endif
+}
