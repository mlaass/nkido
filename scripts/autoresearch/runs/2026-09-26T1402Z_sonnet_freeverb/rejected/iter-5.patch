+// True when every element of the block is bit-identical to the first.
+[[gnu::always_inline]] CEDAR_TARGET_AVX2 inline bool uniform_block(const float* a) noexcept {
+    const __m256i first = _mm256_castps_si256(_mm256_broadcast_ss(a));
+    __m256i acc = _mm256_set1_epi32(-1);
+    for (std::size_t i = 0; i < BLOCK_SIZE; i += 8) {
+        acc = _mm256_and_si256(acc, _mm256_cmpeq_epi32(
+            _mm256_castps_si256(_mm256_load_ps(a + i)), first));
+    }
+    return _mm256_movemask_epi8(acc) == -1;
+}
+
+// Comb recurrence over one block. cp[ch][c] points at BLOCK_SIZE delay samples
+// of comb c; they are read (delayed) and overwritten (feedback) in place.
+// UNIFORM: damping/feedback are constant across the block and come from
+// d0/o0/f0 (damp, 1-damp, feedback); otherwise they are read per sample.
+// MONO: in_l == in_r, so one input broadcast serves both lanes.
+template <bool UNIFORM, bool MONO>
+[[gnu::always_inline]] CEDAR_TARGET_AVX2 inline void comb_pass(
+    float* const (&cp)[2][8], const float* damp, const float* omd, const float* fb,
+    float d0, float o0, float f0,
+    const float* in_l, const float* in_r, float (&ys)[2][BLOCK_SIZE],
+    __m256 (&fs)[2], __m256 (&x1)[2], __m256 (&y1)[2]) noexcept {
+    constexpr std::size_t N = BLOCK_SIZE;
+    const __m256 rv = _mm256_set1_ps(DC_BLOCKER_R);
+    const float* xin[2] = {in_l, in_r};
+    __m256 bd = _mm256_setzero_ps(), bo = bd, bf = bd;
+    if constexpr (UNIFORM) {
+        bd = _mm256_set1_ps(d0);
+        bo = _mm256_set1_ps(o0);
+        bf = _mm256_set1_ps(f0);
+    }
+
+    for (std::size_t n = 0; n < N; n += 8) {
+        // Comb sums first: they read the delayed samples this iteration overwrites.
+        for (std::size_t ch = 0; ch < 2; ++ch) {
+            __m256 s = _mm256_setzero_ps();
+            for (std::size_t c = 0; c < 8; ++c) s = _mm256_add_ps(s, _mm256_loadu_ps(cp[ch][c] + n));
+            _mm256_store_ps(ys[ch] + n, s);
+        }
+        for (std::size_t h = 0; h < 2; ++h) {
+            const std::size_t nh = n + 4 * h;
+            // v[ch][t]: lanes 0..7 = combs 0..7 at time nh+t.
+            __m256 v[2][4];
+            for (std::size_t ch = 0; ch < 2; ++ch) {
+                for (std::size_t i = 0; i < 4; ++i) {
+                    v[ch][i] = _mm256_insertf128_ps(
+                        _mm256_castps128_ps256(_mm_loadu_ps(cp[ch][i] + nh)),
+                        _mm_loadu_ps(cp[ch][i + 4] + nh), 1);
+                }
+                transpose4x4_lanes(v[ch]);
+            }
+            for (std::size_t t = 0; t < 4; ++t) {
+                if constexpr (!UNIFORM) {
+                    bd = _mm256_broadcast_ss(damp + nh + t);
+                    bo = _mm256_broadcast_ss(omd + nh + t);
+                    bf = _mm256_broadcast_ss(fb + nh + t);
+                }
+                __m256 x = _mm256_broadcast_ss(xin[0] + nh + t);
+                for (std::size_t ch = 0; ch < 2; ++ch) {
+                    if constexpr (!MONO) {
+                        if (ch == 1) x = _mm256_broadcast_ss(xin[1] + nh + t);
+                    }
+                    fs[ch] = _mm256_add_ps(_mm256_mul_ps(v[ch][t], bo), _mm256_mul_ps(fs[ch], bd));
+                    const __m256 dc_out = _mm256_add_ps(_mm256_sub_ps(fs[ch], x1[ch]),
+                                                        _mm256_mul_ps(rv, y1[ch]));
+                    x1[ch] = fs[ch];
+                    y1[ch] = dc_out;
+                    v[ch][t] = _mm256_add_ps(x, _mm256_mul_ps(bf, dc_out));
+                }
+            }
+            for (std::size_t ch = 0; ch < 2; ++ch) {
+                transpose4x4_lanes(v[ch]);
+                for (std::size_t i = 0; i < 4; ++i) {
+                    _mm_storeu_ps(cp[ch][i] + nh, _mm256_castps256_ps128(v[ch][i]));
+                    _mm_storeu_ps(cp[ch][i + 4] + nh, _mm256_extractf128_ps(v[ch][i], 1));
+                }
+            }
+        }
+    }
+}
