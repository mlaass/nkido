 #include "../dsp/constants.hpp"
 #include <cmath>
 
+#include "../dsp/simd.hpp"
+
 namespace cedar {
+namespace kernels {
+#if CEDAR_SIMD_X86
+CEDAR_TARGET_AVX2 inline void add_avx2(const float* a, const float* b, float* out) noexcept {
+    for (std::size_t i = 0; i < BLOCK_SIZE; i += 32) {
+        _mm256_store_ps(out + i, _mm256_add_ps(_mm256_load_ps(a + i), _mm256_load_ps(b + i)));
+        _mm256_store_ps(out + i + 8, _mm256_add_ps(_mm256_load_ps(a + i + 8), _mm256_load_ps(b + i + 8)));
+        _mm256_store_ps(out + i + 16, _mm256_add_ps(_mm256_load_ps(a + i + 16), _mm256_load_ps(b + i + 16)));
+        _mm256_store_ps(out + i + 24, _mm256_add_ps(_mm256_load_ps(a + i + 24), _mm256_load_ps(b + i + 24)));
+    }
+}
+
+CEDAR_TARGET_AVX2 inline void sub_avx2(const float* a, const float* b, float* out) noexcept {
+    for (std::size_t i = 0; i < BLOCK_SIZE; i += 32) {
+        _mm256_store_ps(out + i, _mm256_sub_ps(_mm256_load_ps(a + i), _mm256_load_ps(b + i)));
+        _mm256_store_ps(out + i + 8, _mm256_sub_ps(_mm256_load_ps(a + i + 8), _mm256_load_ps(b + i + 8)));
+        _mm256_store_ps(out + i + 16, _mm256_sub_ps(_mm256_load_ps(a + i + 16), _mm256_load_ps(b + i + 16)));
+        _mm256_store_ps(out + i + 24, _mm256_sub_ps(_mm256_load_ps(a + i + 24), _mm256_load_ps(b + i + 24)));
+    }
+}
+
+CEDAR_TARGET_AVX2 inline void mul_avx2(const float* a, const float* b, float* out) noexcept {
+    for (std::size_t i = 0; i < BLOCK_SIZE; i += 32) {
+        _mm256_store_ps(out + i, _mm256_mul_ps(_mm256_load_ps(a + i), _mm256_load_ps(b + i)));
+        _mm256_store_ps(out + i + 8, _mm256_mul_ps(_mm256_load_ps(a + i + 8), _mm256_load_ps(b + i + 8)));
+        _mm256_store_ps(out + i + 16, _mm256_mul_ps(_mm256_load_ps(a + i + 16), _mm256_load_ps(b + i + 16)));
+        _mm256_store_ps(out + i + 24, _mm256_mul_ps(_mm256_load_ps(a + i + 24), _mm256_load_ps(b + i + 24)));
+    }
+}
+#endif
+}
 
