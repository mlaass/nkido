+// True unless every |lane| of a[0:1], b[0:1] lies in [2^-35, 10] (NaN fails).
+// In that range s + DENORMAL_DC == s exactly and clamp_audio is the identity.
+CEDAR_TARGET_AVX2 inline bool svf_out_of_range(__m128 a, __m128 b) noexcept {
+    const __m128i ab = _mm_castps_si128(_mm_and_ps(_mm_movelh_ps(a, b),
+                                                   _mm_castsi128_ps(_mm_set1_epi32(0x7FFFFFFF))));
+    // Unsigned range test via a bias: bits(2^-35) = 0x2E000000, bits(10) = 0x41200000.
+    const __m128i biased = _mm_add_epi32(ab, _mm_set1_epi32(0x52000000));
+    const __m128i bad = _mm_cmpgt_epi32(biased, _mm_set1_epi32(static_cast<int>(0x93200000u)));
+    return _mm_movemask_ps(_mm_castsi128_ps(bad)) != 0;
+}
