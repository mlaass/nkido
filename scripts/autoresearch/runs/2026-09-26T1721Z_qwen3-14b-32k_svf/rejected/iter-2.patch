-// Written once during static initialisation (src/dsp/simd.cpp); read-only after.
-extern Isa g_active;
+#include "simd.hpp"
+
+namespace kernels {
+#if CEDAR_SIMD_X86
+CEDAR_TARGET_AVX2 inline void svf_simd(const float* input, const float* input_r, const float* freq, const float* q, float* out_l, float* out_r, float a1, float a2, float a3, float k, float* ic1eq, float* ic2eq, const bool stereo_in, const float dry, const float wet, const size_t block_size) noexcept {
+    for (size_t i = 0; i < block_size; i += 8) {
+        __m256 v_input = _mm256_load_ps(input + i);
+        __m256 v_input_r = stereo_in ? _mm256_load_ps(input_r + i) : v_input;
+        __m256 v_freq = _mm256_load_ps(freq + i);
+        __m256 v_q = _mm256_load_ps(q + i);
+
+        // Compute v3 = x - (ic2eq + DENORMAL_DC)
+        __m256 v_ic2eq = _mm256_load_ps(ic2eq + i);
+        __m256 v_denorm = _mm256_set1_ps(DENORMAL_DC);
+        __m256 v_v3 = _mm256_sub_ps(_mm256_shuffle_ps(v_input, v_input_r, _MM_SHUFFLE(0, 0, 0, 0)), _mm256_add_ps(v_ic2eq, v_denorm));
+
+        // Compute v1 = a1*(ic1eq + DENORMAL_DC) + a2*v3
+        __m256 v_ic1eq = _mm256_load_ps(ic1eq + i);
+        __m256 v_a1 = _mm256_set1_ps(a1);
+        __m256 v_a2 = _mm256_set1_ps(a2);
+        __m256 v_ic1eq_denorm = _mm256_add_ps(v_ic1eq, v_denorm);
+        __m256 v_v1 = _mm256_add_ps(_mm256_mul_ps(v_a1, v_ic1eq_denorm), _mm256_mul_ps(v_a2, v_v3));
+
+        // Compute v2 = (ic2eq + DENORMAL_DC) + a2*(ic1eq + DENORMAL_DC) + a3*v3
+        __m256 v_a3 = _mm256_set1_ps(a3);
+        __m256 v_v2 = _mm256_add_ps(_mm256_add_ps(_mm256_add_ps(v_ic2eq, v_denorm), _mm256_mul_ps(v_a2, v_ic1eq_denorm)), _mm256_mul_ps(v_a3, v_v3));
+
+        // Update ic1eq and ic2eq
+        __m256 v_2v1 = _mm256_mul_ps(_mm256_set1_ps(2.0f), v_v1);
+        __m256 v_2v2 = _mm256_mul_ps(_mm256_set1_ps(2.0f), v_v2);
+        __m256 v_ic1eq_new = _mm256_sub_ps(v_2v1, v_ic1eq);
+        __m256 v_ic2eq_new = _mm256_sub_ps(v_2v2, v_ic2eq);
+
+        // Clamp audio
+        __m256 v_ic1eq_clamped = _mm256_max_ps(_mm256_min_ps(v_ic1eq_new, _mm256_set1_ps(10.0f)), _mm256_set1_ps(-10.0f));
+        __m256 v_ic2eq_clamped = _mm256_max_ps(_mm256_min_ps(v_ic2eq_new, _mm256_set1_ps(10.0f)), _mm256_set1_ps(-10.0f));
+
+        _mm256_store_ps(ic1eq + i, v_ic1eq_clamped);
+        _mm256_store_ps(ic2eq + i, v_ic2秒);
+
+        // Compute output
+        __m256 v_x = _mm256_shuffle_ps(v_input, v_input_r, _MM_SHUFFLE(0, 0, 0, 0));
+        __m256 v_hp = _mm256_sub_ps(v_x, _mm256_add_ps(_mm256_mul_ps(_mm256_set1_ps(k), v_v1), v_v2));
+        __m256 v_output = _mm256_add_ps(_mm256_mul_ps(_mm256_set1_ps(dry), v_x), _mm256_mul_ps(_mm256_set1_ps(wet), v_hp));
+        _mm256_store_ps(out_l + i, v_output);
+        _mm256_store_ps(out_r + i, v_output);
+    }
 }
