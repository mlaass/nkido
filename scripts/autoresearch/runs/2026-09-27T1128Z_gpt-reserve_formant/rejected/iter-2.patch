+            state.f1 = f1_a * (1.0f - m) + f1_b * m; state.f2 = f2_a * (1.0f - m) + f2_b * m; state.f3 = f3_a * (1.0f - m) + f3_b * m;
+            state.g1 = g1_a * (1.0f - m) + g1_b * m; state.g2 = g2_a * (1.0f - m) + g2_b * m; state.g3 = g3_a * (1.0f - m) + g3_b * m;
