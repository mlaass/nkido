@@ -45,13 +45,31 @@ CEDAR_TARGET_AVX2 inline void prefetch_out_avx2(const float* out) noexcept {
 }
 }  // namespace detail
 
+// Two chunks (pairs) per iteration, fully unrolled via #pragma GCC unroll:
+// all 32 input loads are issued back-to-back with no loop-control µops or
+// loop branches between them (an 8-iteration kernel loop otherwise costs
+// ~24 extra µops per block — LEA + compare + branch per iteration), and GCC
+// can fold one load of each pair into the arithmetic instruction's memory
+// operand (3 -> 2 fused µops per chunk). Same arithmetic, same operands,
+// bit-identical results; the pragma only removes loop overhead.
+//
+// prefetch_out_avx2 (below) starts the 8 L2->L1 output-line fills before
+// the loads, keeping the write-allocate off the stores' critical path.
+// (Non-temporal stores were measured slower here — both with and without a
+// trailing sfence — so write-back stores + prefetch stay.)
 CEDAR_TARGET_AVX2 inline void add_avx2(const float* a, const float* b, float* out) noexcept {
     CEDAR_SIMD_ASSERT_ALIGNED(a, 32);
     CEDAR_SIMD_ASSERT_ALIGNED(b, 32);
     CEDAR_SIMD_ASSERT_ALIGNED(out, 32);
     detail::prefetch_out_avx2(out);
-    for (std::size_t i = 0; i < BLOCK_SIZE; i += 8) {
-        _mm256_store_ps(out + i, _mm256_add_ps(_mm256_load_ps(a + i), _mm256_load_ps(b + i)));
+#pragma GCC unroll 4
+    for (std::size_t i = 0; i < BLOCK_SIZE; i += 16) {
+        const __m256 a0 = _mm256_load_ps(a + i);
+        const __m256 b0 = _mm256_load_ps(b + i);
+        const __m256 a1 = _mm256_load_ps(a + i + 8);
+        const __m256 b1 = _mm256_load_ps(b + i + 8);
+        _mm256_store_ps(out + i, _mm256_add_ps(a0, b0));
+        _mm256_store_ps(out + i + 8, _mm256_add_ps(a1, b1));
     }
 }
 
@@ -60,8 +78,14 @@ CEDAR_TARGET_AVX2 inline void sub_avx2(const float* a, const float* b, float* ou
     CEDAR_SIMD_ASSERT_ALIGNED(b, 32);
     CEDAR_SIMD_ASSERT_ALIGNED(out, 32);
     detail::prefetch_out_avx2(out);
-    for (std::size_t i = 0; i < BLOCK_SIZE; i += 8) {
-        _mm256_store_ps(out + i, _mm256_sub_ps(_mm256_load_ps(a + i), _mm256_load_ps(b + i)));
+#pragma GCC unroll 4
+    for (std::size_t i = 0; i < BLOCK_SIZE; i += 16) {
+        const __m256 a0 = _mm256_load_ps(a + i);
+        const __m256 b0 = _mm256_load_ps(b + i);
+        const __m256 a1 = _mm256_load_ps(a + i + 8);
+        const __m256 b1 = _mm256_load_ps(b + i + 8);
+        _mm256_store_ps(out + i, _mm256_sub_ps(a0, b0));
+        _mm256_store_ps(out + i + 8, _mm256_sub_ps(a1, b1));
     }
 }
 
@@ -70,8 +94,14 @@ CEDAR_TARGET_AVX2 inline void mul_avx2(const float* a, const float* b, float* ou
     CEDAR_SIMD_ASSERT_ALIGNED(b, 32);
