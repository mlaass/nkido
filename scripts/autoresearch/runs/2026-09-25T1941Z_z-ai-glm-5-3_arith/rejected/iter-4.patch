+// Fast buffer-pointer resolution for the SIMD dispatch path.
+//
+// BufferPool::get() is the guarded diagnostic path: per call it pays a
+// MAX_BUFFERS bounds check, a slab load, a null check and carries cold
+// printf machinery — three calls per ADD/SUB/MUL dispatch. The pool's
+// documented contract (buffer_pool.hpp: "the audio thread only reads slab
+// indices the compile thread has already armed") means a published
+// program's indices always hit live slabs, so the hot path needs only the
+// slab-array load and the fixed 256-buffer stride arithmetic. Any anomaly
+// (out-of-range or un-armed index) falls back to the original guarded
+// get(), so observable behaviour is identical in every case. No allocation,
+// lock or syscall.
+inline float* buf_fast(BufferPool& pool, std::uint16_t index) noexcept {
+    if (index >= MAX_BUFFERS) return pool.get(index);  // cold: guarded path
+    BufferPool::Slab* slab = pool.slabs_[index / SLAB_BUFFERS].get();
+    if (slab == nullptr) return pool.get(index);       // cold: guarded path
+    return slab->data[index % SLAB_BUFFERS].data();
+}
+
 }  // namespace kernels
 
