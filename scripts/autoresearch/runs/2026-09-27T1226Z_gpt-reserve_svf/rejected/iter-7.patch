+// simd: approx std::tan
+CEDAR_TARGET_AVX2 inline float tan_svf_avx2(float x) noexcept {
+    constexpr float HALF_PI = 1.57079632679489661923f;
+    constexpr float QUARTER_PI = 0.78539816339744830962f;
+    const bool reciprocal = x > QUARTER_PI;
+    const float y = reciprocal ? HALF_PI - x : x;
+    const float y2 = y * y;
+    const float p = 0.3333333333333333f + y2 *
+        (0.1333333333333333f + y2 *
+        (0.0539682539682540f + y2 *
+        (0.0218694885361552f + y2 *
+        (0.0088632355299022f + y2 * 0.0035921280365725f))));
+    const float t = y + y * y2 * p;
+    return reciprocal ? 1.0f / t : t;
+}
