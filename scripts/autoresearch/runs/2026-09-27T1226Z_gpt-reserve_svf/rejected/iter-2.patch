+#include "../dsp/simd.hpp"
+
+#if CEDAR_SIMD_X86
+using namespace cedar;
+CEDAR_TARGET_AVX2 inline float svf_tan_avx2(float x) noexcept {
+    constexpr float half_pi = 1.57079632679489661923f;
+    constexpr float quarter_pi = 0.78539816339744830962f;
+    const bool reciprocal = x > quarter_pi;
+    const float y = reciprocal ? (half_pi - x) : x;
+    const float z = y * y;
+    // simd: approx tan (replaces tan)
+    float p = 0.0010015579f;
+    p = 0.0035921280f + z * p;
+    p = 0.0133662595f + z * p;
+    p = 0.0539682539f + z * p;
+    p = 0.1333333333f + z * p;
+    p = 0.3333333333f + z * p;
+    const float t = y + y * z * p;
+    return reciprocal ? (1.0f / t) : t;
+}
+
+template <int Mode>
+CEDAR_TARGET_AVX2 inline void svf_avx2_kernel(cedar::ExecutionContext& ctx, const cedar::Instruction& inst) noexcept {
+    float* out_l = ctx.buffers->get(inst.out_buffer);
+    float* out_r = ctx.buffers->get(static_cast<std::uint16_t>(inst.out_buffer + 1));
+    const float* input = ctx.buffers->get(inst.inputs[0]);
+    const bool stereo_in = (inst.flags & InstructionFlag::STEREO_INPUT) != 0;
+    const float* input_r = stereo_in
+        ? ctx.buffers->get(static_cast<std::uint16_t>(inst.inputs[0] + 1))
+        : nullptr;
+    const float* freq = ctx.buffers->get(inst.inputs[1]);
+    const float* q = ctx.buffers->get(inst.inputs[2]);
+    const float* dry_level = (inst.inputs[3] != 0xFFFF) ? ctx.buffers->get(inst.inputs[3]) : nullptr;
+    const float* wet_level = (inst.inputs[4] != 0xFFFF) ? ctx.buffers->get(inst.inputs[4]) : nullptr;
+    auto& state = ctx.states->get_or_create<SVFState>(inst.state_id);
+
+    for (std::size_t i = 0; i < BLOCK_SIZE; ++i) {
+        const float g = svf_tan_avx2(3.14159265358979323846f * freq[i] / ctx.sample_rate);
+        state.k = 1.0f / q[i];
+        state.a1 = 1.0f / (1.0f + g * (g + state.k));
+        state.a2 = g * state.a1;
+        state.a3 = g * state.a2;
+        const float dry = drywet::coeff(dry_level, i, 0.0f);
+        const float wet = drywet::coeff(wet_level, i, 1.0f);
+
+        const float x_l = input[i];
+        const float x_r = stereo_in ? input_r[i] : input[i];
+        const __m128 x = _mm_setr_ps(x_l, x_r, x_l, x_r);
+        const __m128 ic1 = _mm_setr_ps(state.ic1eq[0] + DENORMAL_DC,
+                                       state.ic1eq[1] + DENORMAL_DC,
+                                       state.ic1eq[0] + DENORMAL_DC,
+                                       state.ic1eq[1] + DENORMAL_DC);
+        const __m128 ic2 = _mm_setr_ps(state.ic2eq[0] + DENORMAL_DC,
+                                       state.ic2eq[1] + DENORMAL_DC,
+                                       state.ic2eq[0] + DENORMAL_DC,
+                                       state.ic2eq[1] + DENORMAL_DC);
+        const __m128 v3 = _mm_sub_ps(x, ic2);
+        const __m128 v1v = _mm_add_ps(_mm_mul_ps(_mm_set1_ps(state.a1), ic1),
+                                      _mm_mul_ps(_mm_set1_ps(state.a2), v3));
+        const __m128 v2v = _mm_add_ps(ic2,
+                                      _mm_add_ps(_mm_mul_ps(_mm_set1_ps(state.a2), ic1),
+                                                 _mm_mul_ps(_mm_set1_ps(state.a3), v3)));
+        const float v1_l = _mm_cvtss_f32(v1v);
+        const float v1_r = _mm_cvtss_f32(_mm_shuffle_ps(v1v, v1v, _MM_SHUFFLE(1, 1, 1, 1)));
+        const float v2_l = _mm_cvtss_f32(v2v);
+        const float v2_r = _mm_cvtss_f32(_mm_shuffle_ps(v2v, v2v, _MM_SHUFFLE(1, 1, 1, 1)));
+        state.ic1eq[0] = clamp_audio(2.0f * v1_l - state.ic1eq[0]);
+        state.ic2eq[0] = clamp_audio(2.0f * v2_l - state.ic2eq[0]);
+        state.ic1eq[1] = clamp_audio(2.0f * v1_r - state.ic1eq[1]);
+        state.ic2eq[1] = clamp_audio(2.0f * v2_r - state.ic2eq[1]);
+        const float y_l = (Mode == 0) ? v2_l : ((Mode == 1) ? (x_l - state.k * v1_l - v2_l) : v1_l);
+        const float y_r = (Mode == 0) ? v2_r : ((Mode == 1) ? (x_r - state.k * v1_r - v2_r) : v1_r);
+        out_l[i] = drywet::mix(x_l, y_l, dry, wet);
+        out_r[i] = drywet::mix(x_r, y_r, dry, wet);
+    }
+}
+#endif
