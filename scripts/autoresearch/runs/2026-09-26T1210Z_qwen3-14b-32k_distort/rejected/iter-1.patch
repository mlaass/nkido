+// Approximation for tanh using 2*x/(1 + exp(-2x)) - 1
+// This is equivalent to tanh(x) and has sufficient accuracy for audio processing
+#define TANH_SIMD(x) _mm256_sub_ps(_mm256_mul_ps(_mm256_set1_ps(2.0f), x), _mm256_div_ps(_mm256_set1_ps(1.0f), _mm256_add_ps(_mm256_set1_ps(1.0f), _mm256_exp_ps(_mm256_mul_ps(_mm256_set1_ps(-2.0f), x)))))
+
+CEDAR_TARGET_AVX2 inline void distort_tanh_avx2(const float* input, const float* drive, float* out_l, float* out_r, const float* dry_level, const float* wet_level, bool stereo_in, const float* input_r, const float* input, const float* dry_level_fallback, const float* wet_level_fallback) noexcept {
+    __m256 dry_const = _mm256_set1_ps(0.0f);
+    __m256 wet_const = _mm256_set1_ps(1.0f);
+
+    for (std::size_t i = 0; i < BLOCK_SIZE; i += 8) {
+        __m256 drive_vec = _mm256_load_ps(drive + i);
+        drive_vec = _mm256_max_ps(drive_vec, _mm256_set1_ps(0.1f));
+
+        __m256 input_vec = _mm256_load_ps(input + i);
+        __m256 input_r_vec = stereo_in ? _mm256_load_ps(input_r + i) : input_vec;
+
+        __m256 x_l = input_vec;
+        __m256 x_r = input_r_vec;
+
+        __m256 xld = _mm256_mul_ps(x_l, drive_vec);
+        __m256 xrd = _mm256_mul_ps(x_r, drive_vec);
+
+        __m256 tanh_xld = TANH_SIMD(xld);
+        __m256 tanh_xrd = TANH_SIMD(xrd);
 
-// Best ISA available on this CPU *and* compiled into this build.
-[[nodiscard]] inline Isa active() noexcept { return detail::g_active; }
+        // Assume dry_level and wet_level are constants for this approximation
+        __m256 dry = dry_const;
+        __m256 wet = wet_const;
 
-// True when kernels for `isa` may run. x86 levels nest (Avx2 implies Sse2).
-[[nodiscard]] inline bool has(Isa isa) noexcept {
-    const Isa a = detail::g_active;
-    if (isa == Isa::Scalar) return true;
-    if (isa == Isa::Sse2) return a == Isa::Sse2 || a == Isa::Avx2;
-    return a == isa;
+        __m256 mix_l = _mm256_add_ps(_mm256_mul_ps(dry, x_l), _mm256_mul_ps(wet, tanh_xld));
+        __m256 mix_r = _mm256_add_ps(_mm256_mul_ps(dry, x_r), _mm256_mul_ps(wet, tanh_xrd));
+
+        _mm256_store_ps(out_l + i, mix_l);
+        _mm256_store_ps(out_r + i, mix_r);
+    }
 }
 
