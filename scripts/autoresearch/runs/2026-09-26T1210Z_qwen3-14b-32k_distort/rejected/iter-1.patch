+// Polynomial approximation for soft function without branches
+CEDAR_TARGET_AVX2 inline void distort_soft_avx2(const float* input, const float* threshold, float* out_l, float* out_r, const float* dry_level, const float* wet_level, bool stereo_in, const float* input_r, const float* input, const float* dry_level_fallback, const float* wet_level_fallback) noexcept {
+    __m256 dry_const = _mm256_set1_ps(0.0f);
+    __m256 wet_const = _mm256_set1_ps(1.0f);
+
+    for (std::size_t i = 0; i < BLOCK_SIZE; i += 8) {
+        __m256 threshold_vec = _mm256_load_ps(threshold + i);
+        threshold_vec = _mm256_clamp_ps(threshold_vec, _mm256_set1_ps(0.1f), _mm256_set1_ps(2.0f));
+
+        __m256 input_vec = _mm256_load_ps(input + i);
+        __m256 input_r_vec = stereo_in ? _mm256_load_ps(input_r + i) : input_vec;
+
+        __m256 x_l = input_vec;
+        __m256 x_r = input_r_vec;
+
+        __m256 x_div_t = _mm256_div_ps(x_l, threshold_vec);
+        __m256 x2 = _mm256_mul_ps(x_div_t, x_div_t);
+        __m256 x_soft = _mm256_mul_ps(x_div_t, _mm256_div_ps(_mm256_add_ps(_mm256_set1_ps(27.0f), x2), _mm256_add_ps(_mm256_set1_ps(27.0f), _mm256_mul_ps(_mm256_set1_ps(9.0f), x2))));
+        x_soft = _mm256_mul_ps(x_soft, threshold_vec);
+
+        __m256 x_r_div_t = _mm256_div_ps(x_r, threshold_vec);
+        __m256 x_r2 = _mm256_mul_ps(x_r_div_t, x_r_div_t);
+        __m256 x_r_soft = _mm256_mul_ps(x_r_div_t, _mm256_div_ps(_mm256_add_ps(_mm256_set1_ps(27.0f), x_r2), _mm256_add_ps(_mm256_set1_ps(27.0f), _mm256_mul_ps(_mm256_set1_ps(9.0f), x_r2))));
+        x_r_soft = _mm256_mul_ps(x_r_soft, threshold_vec);
+
+        __m256 mix_l = _mm256_add_ps(_mm256_mul_ps(dry_const, x_l), _mm256_mul_ps(wet_const, x_soft));
+        __m256 mix_r = _mm256_add_ps(_mm256_mul_ps(dry_const, x_r), _mm256_mul_ps(wet_const, x_r_soft));
+
+        _mm256_store_ps(out_l + i, mix_l);
+        _mm256_store_ps(out_r + i, mix_r);
+    }
+}
 
