+    const __m256 vn3 = _mm256_set1_ps(-3.0f);
+    const __m256 xc = _mm256_min_ps(_mm256_max_ps(x, vn3), v3);
     const __m256 x2 = _mm256_mul_ps(xc, xc);
     const __m256 num = _mm256_mul_ps(xc, _mm256_add_ps(_mm256_set1_ps(27.0f), x2));
