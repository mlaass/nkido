 inline void op_distort_tanh(ExecutionContext& ctx, const Instruction& inst) {
+#if CEDAR_SIMD_X86
+    if (simd::has(simd::Isa::Avx2)) {
+        float* simd_out_l = ctx.buffers->get(inst.out_buffer);
+        float* simd_out_r = ctx.buffers->get(static_cast<std::uint16_t>(inst.out_buffer + 1));
+        const float* simd_input_l = ctx.buffers->get(inst.inputs[0]);
+        const bool simd_stereo = (inst.flags & InstructionFlag::STEREO_INPUT) != 0;
+        const float* simd_input_r = simd_stereo
+            ? ctx.buffers->get(static_cast<std::uint16_t>(inst.inputs[0] + 1))
+            : nullptr;
+        const float* simd_drive = ctx.buffers->get(inst.inputs[1]);
+        const float* simd_dry = (inst.inputs[2] != 0xFFFF) ? ctx.buffers->get(inst.inputs[2]) : nullptr;
+        const float* simd_wet = (inst.inputs[3] != 0xFFFF) ? ctx.buffers->get(inst.inputs[3]) : nullptr;
+        kernels::distort_tanh_avx2(simd_input_l, simd_input_r, simd_drive,
+                                   simd_dry, simd_wet, simd_out_l, simd_out_r);
+        return;
+    }
+#endif
     float* out_l = ctx.buffers->get(inst.out_buffer);
     float* out_r = ctx.buffers->get(static_cast<std::uint16_t>(inst.out_buffer + 1));
     const float* input = ctx.buffers->get(inst.inputs[0]);
