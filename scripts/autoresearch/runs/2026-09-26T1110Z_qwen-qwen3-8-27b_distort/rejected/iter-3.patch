+// Bit-identical AVX2 kernel for op_distort_soft.  The shape function is a
+// fixed polynomial plus two comparisons, so *nothing* is approximated:
+// each multiply and add is one IEEE-754 float op, the division is
+// `_mm256_div_ps` (current SSE2 semantics — round-to-nearest-even,
+// identical to the scalar `x / y`), and the saturating clamp is rebuilt
+// from the exact branch conditions, not the FMA-less _mm256_min_ps/max_ps
+// (which would be the *wrong* NaN semantics: the scalar `if (x > 3.0f)`
+// is false for NaN and keeps the polynomial value).  Same code therefore
+// works for any float rounding mode the engine is built with.
+CEDAR_TARGET_AVX2 inline void distort_soft_avx2(const float* in_l, const float* in_r,
+                                                const float* threshold, const float* dry_level,
+                                                const float* wet_level, float* out_l,
+                                                float* out_r) noexcept {
+    CEDAR_SIMD_ASSERT_ALIGNED(in_l, 32);
+    CEDAR_SIMD_ASSERT_ALIGNED(in_r, 32);
+    CEDAR_SIMD_ASSERT_ALIGNED(threshold, 32);
+    CEDAR_SIMD_ASSERT_ALIGNED(out_l, 32);
+    CEDAR_SIMD_ASSERT_ALIGNED(out_r, 32);
+    if (dry_level) CEDAR_SIMD_ASSERT_ALIGNED(dry_level, 32);
+    if (wet_level) CEDAR_SIMD_ASSERT_ALIGNED(wet_level, 32);
+
+    for (std::size_t i = 0; i < BLOCK_SIZE; i += 8) {
+        // soft(u) = u(27 + u^2)/(27 + 9u^2), clamped to +/-1 past |u| > 3.
+        // Exact mirror of the scalar lambda: one IEEE mul/add per op, same
+        // association; the clamp restores the two early-return branches
+        // only (strict comparisons, so NaN keeps the polynomial value).
+        auto soft8 = [](__m256 x) {
+            const __m256 one = _mm256_set1_ps(1.0f);
+            const __m256 sign = _mm256_set1_ps(-0.0f);          // bit 0x80000000
+            const __m256 three = _mm256_set1_ps(3.0f);
+            const __m256 neg_three = _mm256_set1_ps(-3.0f);
+            const __m256 c27 = _mm256_set1_ps(27.0f);
+            const __m256 c9 = _mm256_set1_ps(9.0f);
+            __m256 x2 = _mm256_mul_ps(x, x);
+            __m256 num = _mm256_mul_ps(x, _mm256_add_ps(c27, x2));
+            __m256 den = _mm256_add_ps(c27, _mm256_mul_ps(c9, x2));
+            __m256 poly = _mm256_div_ps(num, den);
+            __m256 hi = _mm256_cmpeq_ps(_mm256_cmp_ps(x, three, _CMP_GT_OQ), one);
+            __m256 lo = _mm256_cmpeq_ps(_mm256_cmp_ps(x, neg_three, _CMP_LT_OQ), one);
+            return _mm256_or_ps(_mm256_or_ps(_mm256_and_ps(hi, one),
+                                             _mm256_and_ps(_mm256_and_ps(lo, sign), poly)),
+                                _mm256_andnot_ps(_mm256_or_ps(hi, lo), poly));
+        };
+
+        const __m256 tmin = _mm256_set1_ps(0.1f);
+        const __m256 tmax = _mm256_set1_ps(2.0f);
+        __m256 t = _mm256_load_ps(threshold + i);
+        t = _mm256_max_ps(t, tmin);
+        t = _mm256_min_ps(t, tmax);
+        __m256 xL = _mm256_load_ps(in_l + i);
+        __m256 xR = _mm256_load_ps(in_r + i);
+        __m256 dry = dry_level ? _mm256_load_ps(dry_level + i) : _mm256_setzero_ps();
+        __m256 wet = wet_level ? _mm256_load_ps(wet_level + i) : _mm256_set1_ps(1.0f);
+        _mm256_store_ps(out_l + i, _mm256_add_ps(_mm256_mul_ps(xL, dry),
+                                                 _mm256_mul_ps(_mm256_mul_ps(soft8(_mm256_div_ps(xL, t)), t), wet)));
+        _mm256_store_ps(out_r + i, _mm256_add_ps(_mm256_mul_ps(xR, dry),
+                                                 _mm256_mul_ps(_mm256_mul_ps(soft8(_mm256_div_ps(xR, t)), t), wet)));
+    }
+}
